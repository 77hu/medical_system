# ===========================================
# AI Patient-Doctor System - 环境变量配置
# 复制此文件为 .env 并填入真实密钥
# ===========================================

# 评估模型 — SiliconFlow (DeepSeek-R1-Distill-Qwen-32B)
API_KEY_EVAL=your-siliconflow-api-key-here
API_URL_EVAL=https://api.siliconflow.cn/v1/chat/completions
EVAL_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B

# 医生模型 — Azure OpenAI (o3-mini)
API_KEY_DOCTOR=your-azure-openai-api-key-here
API_URL_DOCTOR=https://your-resource.openai.azure.com/openai/deployments/o3-mini/chat/completions?api-version=2025-01-01-preview
DOCTOR_MODEL=gpt-o3mini

# 病人模型 — Azure AI MAAS (Llama-3.3-70B-Instruct)
API_KEY_PATIENT=your-azure-ai-api-key-here
API_URL_PATIENT=https://your-resource.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
PATIENT_MODEL=Llama-3.3-70B-Instruct
